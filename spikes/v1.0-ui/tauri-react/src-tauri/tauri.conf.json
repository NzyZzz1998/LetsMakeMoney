{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LMM v1.0 Tauri Spike",
  "version": "1.0.0",
  "identifier": "io.letsmakemoney.v1-spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LetsMakeMoney",
        "width": 344,
        "height": 120,
        "minWidth": 344,
        "minHeight": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

