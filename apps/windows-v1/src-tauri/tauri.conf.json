{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LetsMakeMoney",
  "version": "1.0.8",
  "identifier": "io.letsmakemoney.windows",
  "build": {
    "beforeDevCommand": "node_modules\\.bin\\vite.cmd",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node_modules\\.bin\\tsc.cmd && node_modules\\.bin\\vite.cmd build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "mini",
        "title": "LetsMakeMoney",
        "url": "index.html?window=mini",
        "width": 344,
        "height": 108,
        "minWidth": 344,
        "minHeight": 108,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
