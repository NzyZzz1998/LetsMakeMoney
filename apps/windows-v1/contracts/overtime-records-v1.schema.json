{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NzyZzz1998/LetsMakeMoney/contracts/overtime-records-v1.schema.json",
  "title": "LetsMakeMoney overtime records v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "business_date",
          "minutes",
          "hourly_rate_fen_snapshot",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "business_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "hourly_rate_fen_snapshot": { "type": "integer", "minimum": 0 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
