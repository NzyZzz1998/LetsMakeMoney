{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letsmakemoney.app/contracts/ipc-fixture-v1.schema.json",
  "title": "LetsMakeMoney IPC fixture contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "config_version", "scenarios"],
  "properties": {
    "contract_version": {"const": 1},
    "config_version": {"const": 8},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "implementation_status", "command", "request", "expected", "invariants"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "domain": {"enum": ["configuration", "dashboard", "window", "overtime"]},
          "implementation_status": {"enum": ["active", "skeleton"]},
          "command": {"type": "string", "minLength": 1},
          "request": {"type": "object"},
          "expected": {"type": "object", "minProperties": 1},
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
