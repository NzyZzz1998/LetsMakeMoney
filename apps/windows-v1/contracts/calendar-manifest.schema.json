{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letsmakemoney.app/contracts/calendar-manifest.schema.json",
  "title": "LetsMakeMoney bundled calendar manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "supported_years", "datasets"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "supported_years": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "file", "sha256"],
        "properties": {
          "year": {"type": "integer"},
          "file": {"type": "string", "pattern": "^cn-20\\d{2}\\.json$"},
          "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
        }
      }
    }
  }
}
